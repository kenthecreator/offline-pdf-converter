<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="VerifySingleExecutable" AfterTargets="Publish">
    <!-- The native Skia dependency publishes its own debug symbols independently. -->
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
    <ItemGroup>
      <UnexpectedPublishFile Include="$(PublishDir)**/*" Exclude="$(PublishDir)$(AssemblyName).exe" />
    </ItemGroup>
    <Error Condition="'@(UnexpectedPublishFile)' != ''" Text="単体exe以外の配布ファイルが残っています: @(UnexpectedPublishFile)" />
    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).exe')" Text="配布するexeが見つかりません。" />
  </Target>
</Project>
