<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OfflinePDFConverter.Views.MainWindow"
        Title="Offline PDF Converter (v3.1.0)"
        Width="1120"
        Height="760"
        MinWidth="1040"
        MinHeight="760"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        UseLayoutRounding="True"
        DragDrop.AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="GlassShellBrush" Color="#DDF5F5F5" />
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#D8FFFFFF" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="#E4F7F7F7" />
    <SolidColorBrush x:Key="GlassButtonBrush" Color="#DDEDEDED" />
    <SolidColorBrush x:Key="GlassAccentBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="GlassDarkPillBrush" Color="#ECE7E7E7" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202020" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#141414" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#606060" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#EFFFFFFF" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#66969696" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#66999999" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#558F8F8F" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#66898989" />
    <SolidColorBrush x:Key="ModeButtonBorderBrush" Color="#6C868686" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeTrackBrush" Color="#A0606060" />
    <SolidColorBrush x:Key="ThemeThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeIconBrush" Color="#050505" />
    <SolidColorBrush x:Key="ModeTrackBrush" Color="#08000000" />
    <SolidColorBrush x:Key="ModeTrackBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ModePillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ModePillBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ModeSelectedTextBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="ModeUnselectedTextBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="ComboMenuBackgroundBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ComboMenuBorderBrush" Color="#38000000" />
    <SolidColorBrush x:Key="ComboMenuHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="ComboMenuSelectedBrush" Color="#D8D8D8" />
    <SolidColorBrush x:Key="ComboMenuSelectedTextBrush" Color="#111111" />
    <SolidColorBrush x:Key="PdfDpiTrackBrush" Color="#10000000" />
    <SolidColorBrush x:Key="PdfDpiThumbBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PdfDpiThumbBorderBrush" Color="#42000000" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource GlassButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.mode-segment">
      <Setter Property="Width" Value="216" />
      <Setter Property="Height" Value="68" />
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.mode-segment TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground"
                           Duration="0:0:0.15"
                           Easing="0.4,0,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.mode-segment:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.mode-segment:checked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ModeSelectedTextBrush}" />
    </Style>
    <Style Selector="RadioButton.mode-segment:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontSize" Value="25" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="28,10" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.small-action">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{DynamicResource GlassButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
        </Transitions>
      </Setter>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.direction-segment">
      <Setter Property="Width" Value="133" />
      <Setter Property="Height" Value="46" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.direction-segment TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="0.4,0,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.direction-segment:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.direction-segment:checked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ModeSelectedTextBrush}" />
    </Style>
    <Style Selector="RadioButton.direction-segment:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="RadioButton.preview-segment">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.preview-segment TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="0.4,0,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.preview-segment:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.preview-segment:checked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ModeSelectedTextBrush}" />
    </Style>
    <Style Selector="RadioButton.preview-segment:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.theme-segment-label">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground"
                           Duration="0:0:0.15"
                           Easing="0.4,0,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.theme-segment-label.selected">
      <Setter Property="Foreground" Value="{DynamicResource ModeSelectedTextBrush}" />
    </Style>
    <Style Selector="Button.theme-toggle">
      <Setter Property="Width" Value="86" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource GlassDarkPillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.resolution-tick">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource ModeUnselectedTextBrush}" />
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="0:0:0.3"
                           Easing="0.23,1,0.32,1" />
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.2"
                            Easing="0.23,1,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.resolution-tick.selected">
      <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{DynamicResource ComboMenuBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComboMenuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="5,7" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #45000000, 0 1 3 0 #26000000" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="2,2" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource ComboMenuHoverBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource ComboMenuSelectedBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ComboMenuSelectedTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource ComboMenuSelectedBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ComboMenuSelectedTextBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox.pdf-inline-editor">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.pdf-inline-editor:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.pdf-inline-editor:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource GlassAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource GlassButtonBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.19" Easing="0.16,0.84,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid x:Name="ThemeTransitionRoot"
          RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource AppBackgroundBrush}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="34,24,34,14">
      <Image x:Name="AppHeaderIcon"
             Source="/Assets/AppIconLight.png"
             Width="70"
             Height="70"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             Stretch="Uniform" />

      <Viewbox x:Name="AppHeaderTitleViewbox"
               Grid.Column="1"
               Margin="16,0,24,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform"
               StretchDirection="DownOnly">
        <TextBlock FontSize="28"
                   HorizontalAlignment="Left"
                   TextAlignment="Left"
                   Foreground="{DynamicResource TextStrongBrush}"><Run Text="Offline PDF Converter" FontWeight="Bold" /><Run Text=" (v3.1.0)" FontWeight="Normal" /></TextBlock>
      </Viewbox>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <Border x:Name="ModeSelectorSwitch"
                Width="436"
                Height="68"
                CornerRadius="34"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                AutomationProperties.Name="表示モード"
                AutomationProperties.HelpText="クリックまたは左右へドラッグして表示モードを切り替えます"
                AutomationProperties.ControlTypeOverride="Group"
                KeyDown="OnModeSelectorKeyDown">
          <Grid Width="432" Height="68" ColumnDefinitions="216,216">
            <Border Grid.ColumnSpan="2"
                    Height="64"
                    Margin="1,0"
                    CornerRadius="32"
                    Background="{DynamicResource ModeTrackBrush}"
                    BorderBrush="{DynamicResource ModeTrackBorderBrush}"
                    BorderThickness="0"
                    IsHitTestVisible="False" />
            <Border x:Name="ModeSelectionPill"
                    Width="225"
                    Height="69"
                    Margin="-0.5,0,0,0"
                    HorizontalAlignment="Left"
                    CornerRadius="34.5"
                    Background="{DynamicResource ModePillBrush}"
                    BorderBrush="{DynamicResource ModePillBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 1 6 0 #0D000000"
                    IsHitTestVisible="False">
              <Border.RenderTransform>
                <TranslateTransform X="0">
                  <TranslateTransform.Transitions>
                    <Transitions>
                      <DoubleTransition Property="X"
                                        Duration="0:0:0.5"
                                        Easing="0.18,0.89,0.22,1.04" />
                    </Transitions>
                  </TranslateTransform.Transitions>
                </TranslateTransform>
              </Border.RenderTransform>
            </Border>

            <RadioButton x:Name="PdfToolsModeButton"
                         Grid.Column="0"
                         Classes="mode-segment"
                         GroupName="MainMode"
                         IsChecked="True"
                         AutomationProperties.Name="PDF編集"
                         AutomationProperties.HelpText="PDFの結合、分割、ページ編集を表示します"
                         Click="OnPdfToolsModeClick">
              <TextBlock x:Name="PdfToolsModeLabel" Text="PDF編集">
                <TextBlock.RenderTransform>
                  <TranslateTransform X="4" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </RadioButton>
            <RadioButton x:Name="PdfModeButton"
                         Grid.Column="1"
                         Classes="mode-segment"
                         GroupName="MainMode"
                         AutomationProperties.Name="PDFと画像"
                         AutomationProperties.HelpText="PDFと画像の相互変換を表示します"
                         Click="OnPdfModeClick">
              <TextBlock x:Name="PdfModeLabel" Text="PDF ↔ 画像">
                <TextBlock.RenderTransform>
                  <TranslateTransform X="-4" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </RadioButton>
          </Grid>
        </Border>
        <Border x:Name="ThemeToggleSwitch"
                Width="82"
                Height="36"
                CornerRadius="18"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="True"
                AutomationProperties.Name="テーマ切替"
                AutomationProperties.HelpText="左でライト、右でダークを選びます。クリック、ドラッグ、左右キーで切り替えられます"
                KeyDown="OnThemeSelectorKeyDown">
          <Grid Width="82" Height="36" ColumnDefinitions="41,41">
            <Border Grid.ColumnSpan="2"
                    Height="34"
                    Margin="1,0"
                    CornerRadius="17"
                    Background="{DynamicResource ModeTrackBrush}"
                    BorderBrush="{DynamicResource ModeTrackBorderBrush}"
                    BorderThickness="0"
                    IsHitTestVisible="False" />
            <Border x:Name="ThemeToggleThumb"
                    Width="50"
                    Height="37"
                    Margin="-0.5,0,0,0"
                    CornerRadius="18.5"
                    Background="{DynamicResource ModePillBrush}"
                    BorderBrush="{DynamicResource ModePillBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 1 6 0 #0D000000"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
              <Border.RenderTransform>
                <TranslateTransform X="0">
                  <TranslateTransform.Transitions>
                    <Transitions>
                      <DoubleTransition Property="X"
                                        Duration="0:0:0.5"
                                        Easing="0.18,0.89,0.22,1.04" />
                    </Transitions>
                  </TranslateTransform.Transitions>
                </TranslateTransform>
              </Border.RenderTransform>
            </Border>

            <TextBlock x:Name="ThemeLightLabel"
                       Grid.Column="0"
                       Classes="theme-segment-label selected"
                       Text="☀"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
              <TextBlock.RenderTransform>
                <TranslateTransform X="4" />
              </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="ThemeDarkLabel"
                       Grid.Column="1"
                       Classes="theme-segment-label"
                       Text="☾"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
              <TextBlock.RenderTransform>
                <TranslateTransform X="-4" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="34,0,34,16">
      <Grid x:Name="PdfPanel" ColumnDefinitions="*,240" ColumnSpacing="22" IsVisible="False">
        <Border Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="24">
          <Border Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Margin="0,54,0,0"
                    Padding="16">
              <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="PDFファイル"
                             FontSize="20"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="small-action" Content="追加" Click="OnAddPdfFilesClick" />
                    <Button Classes="small-action" Content="削除" Click="OnRemovePdfFilesClick" />
                    <Button Classes="small-action" Content="すべて削除" Click="OnClearPdfFilesClick" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                  <ListBox x:Name="PdfFilesList"
                           SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="10,7">
                          <TextBlock Text="{Binding DisplayName}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Folder}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="PdfFilesEmptyHint"
                             Text="「追加」ボタンをクリックするか、PDFファイルをドロップ"
                             Foreground="{DynamicResource TextSubtleBrush}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />
                </Grid>
              </Grid>
          </Border>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="14"
                ClipToBounds="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <TextBlock Text="出力設定"
                         FontSize="22"
                         FontWeight="Bold"
                         HorizontalAlignment="Center" />

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="画像形式" HorizontalAlignment="Center" />
                  <ComboBox x:Name="PdfFormatCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="PNG" />
                    <ComboBoxItem Content="JPEG" />
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="9">
                  <TextBlock Classes="label" Text="解像度" HorizontalAlignment="Center" />
                  <Border x:Name="PdfDpiSliderSwitch"
                          Width="212"
                          Height="32"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Focusable="True"
                          Cursor="Hand"
                          AutomationProperties.Name="解像度"
                          AutomationProperties.HelpText="左右キーまたはドラッグで、普通、高画質、超高画質から選択します">
                    <Grid x:Name="PdfDpiSliderRoot"
                          Width="196"
                          Height="28"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                      <Border x:Name="PdfDpiTrack"
                              Width="196"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              CornerRadius="12"
                              Background="{DynamicResource PdfDpiTrackBrush}"
                              BorderBrush="{DynamicResource ModeTrackBorderBrush}"
                              BorderThickness="1"
                              ClipToBounds="True">
                        <Border x:Name="PdfDpiRange"
                                Width="14"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="12,0,0,12"
                                Background="{DynamicResource GlassAccentBrush}">
                          <Border.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Width"
                                                Duration="0:0:0.3"
                                                Easing="0.23,1,0.32,1" />
                            </Transitions>
                          </Border.Transitions>
                        </Border>
                      </Border>

                      <Border x:Name="PdfDpiTickNormal"
                              Classes="resolution-tick selected"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="11,0,0,0"
                              IsHitTestVisible="False" />
                      <Border x:Name="PdfDpiTickHigh"
                              Classes="resolution-tick"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False" />
                      <Border x:Name="PdfDpiTickUltra"
                              Classes="resolution-tick"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,11,0"
                              IsHitTestVisible="False" />

                      <Border x:Name="PdfDpiThumb"
                              Width="30"
                              Height="30"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              CornerRadius="15"
                              Background="{DynamicResource PdfDpiThumbBrush}"
                              BorderBrush="{DynamicResource PdfDpiThumbBorderBrush}"
                              BorderThickness="1"
                              BoxShadow="0 2 8 0 #38000000, 0 0 2 0 #26000000"
                              IsHitTestVisible="False">
                        <Border.RenderTransform>
                          <TranslateTransform X="0">
                            <TranslateTransform.Transitions>
                              <Transitions>
                                <DoubleTransition Property="X"
                                                  Duration="0:0:0.3"
                                                  Easing="0.23,1,0.32,1" />
                              </Transitions>
                            </TranslateTransform.Transitions>
                          </TranslateTransform>
                        </Border.RenderTransform>
                      </Border>
                    </Grid>
                  </Border>

                  <TextBlock x:Name="PdfDpiCurrentHint"
                             Text="普通 · 200 dpi"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="出力先フォルダ" HorizontalAlignment="Center" />
                  <TextBox x:Name="PdfOutputFolderTextBox" Watermark="保存先フォルダ" />
                  <Button Classes="small-action" Content="選択" Click="OnSelectPdfOutputFolderClick" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="書き出しファイル名" HorizontalAlignment="Center" />
                  <TextBox x:Name="PdfOutputBaseNameTextBox" Watermark="例: output" />
                  <TextBlock Text="複数ページは _page001 を付けて保存します。"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Grid x:Name="ImagePanel" ColumnDefinitions="*,240" ColumnSpacing="22" IsVisible="False">
        <Border Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="24">
          <Border Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Margin="0,54,0,0"
                    Padding="16">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="画像ファイル"
                             FontSize="20"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="small-action" Content="追加" Click="OnAddImageFilesClick" />
                    <Button Classes="small-action" Content="削除" Click="OnRemoveImageFilesClick" />
                    <Button Classes="small-action" Content="すべて削除" Click="OnClearImageFilesClick" />
                  </StackPanel>
                </Grid>

                <ListBox x:Name="ImageFilesList"
                         Grid.Row="1"
                         SelectionMode="Multiple">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="10,7">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Classes="small-action" Content="上へ" Click="OnMoveImageUpClick" />
                  <Button Classes="small-action" Content="下へ" Click="OnMoveImageDownClick" />
                  <TextBlock Text="「追加」ボタンをクリックするか、画像ファイルをドロップ"
                             Foreground="{DynamicResource TextSubtleBrush}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0" />
                </StackPanel>
              </Grid>
          </Border>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="14"
                ClipToBounds="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <TextBlock Text="PDF設定"
                         FontSize="22"
                         FontWeight="Bold"
                         HorizontalAlignment="Center" />

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="ページサイズ" HorizontalAlignment="Center" />
                  <ComboBox x:Name="ImagePageModeCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="A4縦" />
                    <ComboBoxItem Content="A4横" />
                    <ComboBoxItem Content="画像サイズに合わせる" />
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <CheckBox x:Name="ImageMarginCheckBox"
                          Content="余白あり"
                          HorizontalAlignment="Center" />
              </Border>

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="出力PDF" HorizontalAlignment="Center" />
                  <TextBox x:Name="ImageOutputPdfTextBox" Watermark="保存先とPDF名" />
                  <Button Classes="small-action" Content="選択" Click="OnSelectImageOutputPdfClick" />
                  <TextBlock Classes="label" Text="書き出しファイル名" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  <TextBox x:Name="ImageOutputBaseNameTextBox" Watermark="例: converted_images" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Grid x:Name="DirectionSelectorHost"
            ColumnDefinitions="*,240"
            ColumnSpacing="22"
            IsVisible="False"
            Panel.ZIndex="10">
        <Border x:Name="DirectionSelectorSwitch"
                Grid.Column="0"
                Width="270"
                Height="46"
                Margin="0,20,0,0"
                CornerRadius="23"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                AutomationProperties.Name="変換方向"
                AutomationProperties.HelpText="クリックまたは左右へドラッグして変換方向を切り替えます"
                AutomationProperties.ControlTypeOverride="Group"
                KeyDown="OnDirectionSelectorKeyDown">
          <Grid Width="266" Height="46" ColumnDefinitions="133,133">
            <Border Grid.ColumnSpan="2"
                    Height="43"
                    Margin="1,0"
                    CornerRadius="21.5"
                    Background="{DynamicResource ModeTrackBrush}"
                    BorderBrush="{DynamicResource ModeTrackBorderBrush}"
                    BorderThickness="0"
                    IsHitTestVisible="False" />
            <Border x:Name="DirectionSelectionPill"
                    Width="142"
                    Height="47"
                    Margin="-0.5,0,0,0"
                    HorizontalAlignment="Left"
                    CornerRadius="23.5"
                    Background="{DynamicResource ModePillBrush}"
                    BorderBrush="{DynamicResource ModePillBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 1 6 0 #0D000000"
                    IsHitTestVisible="False">
              <Border.RenderTransform>
                <TranslateTransform X="0">
                  <TranslateTransform.Transitions>
                    <Transitions>
                      <DoubleTransition Property="X"
                                        Duration="0:0:0.5"
                                        Easing="0.18,0.89,0.22,1.04" />
                    </Transitions>
                  </TranslateTransform.Transitions>
                </TranslateTransform>
              </Border.RenderTransform>
            </Border>

            <RadioButton x:Name="PdfToImageDirectionButton"
                         Grid.Column="0"
                         Classes="direction-segment"
                         GroupName="ConversionDirection"
                         IsChecked="True"
                         AutomationProperties.Name="PDFから画像"
                         AutomationProperties.HelpText="PDFを画像へ変換する画面を表示します"
                         Click="OnPdfToImageDirectionClick">
              <TextBlock x:Name="PdfToImageDirectionLabel" Text="PDF → 画像">
                <TextBlock.RenderTransform>
                  <TranslateTransform X="4" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </RadioButton>
            <RadioButton x:Name="ImageToPdfDirectionButton"
                         Grid.Column="1"
                         Classes="direction-segment"
                         GroupName="ConversionDirection"
                         AutomationProperties.Name="画像からPDF"
                         AutomationProperties.HelpText="画像をPDFへ変換する画面を表示します"
                         Click="OnImageToPdfDirectionClick">
              <TextBlock x:Name="ImageToPdfDirectionLabel" Text="画像 → PDF">
                <TextBlock.RenderTransform>
                  <TranslateTransform X="-4" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </RadioButton>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="PdfToolsPanel" ColumnDefinitions="*,240" ColumnSpacing="22" IsVisible="True">
        <Border Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="22">
          <Grid RowDefinitions="Auto,116,Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="PDFファイル"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock Text="結合する順番で並べます。分割やページ削除にも使います。"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="small-action" Content="追加" Click="OnAddPdfFilesClick" />
                <Button Classes="small-action" Content="削除" Click="OnRemovePdfFilesClick" />
                <Button Classes="small-action" Content="すべて削除" Click="OnClearPdfFilesClick" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
              <ListBox x:Name="PdfToolFilesList"
                       SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="10,7">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Folder}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="PdfToolFilesEmptyHint"
                         Text="「追加」ボタンをクリックするか、PDFファイルをドロップ"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="small-action" Content="上へ" Click="OnMovePdfUpClick" />
              <Button Classes="small-action" Content="下へ" Click="OnMovePdfDownClick" />
            </StackPanel>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="ページプレビュー"
                           FontSize="18"
                           FontWeight="Bold" />
                <TextBlock x:Name="PdfPreviewHelpText"
                           Text="PDFを追加すると、ページの見た目を確認できます。"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           Margin="0,3,0,0" />
              </StackPanel>
              <Border x:Name="PdfPreviewSelectorSwitch"
                      Grid.Column="1"
                      Width="164"
                      Height="38"
                      CornerRadius="19"
                      VerticalAlignment="Bottom"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      AutomationProperties.Name="ページプレビューの表示形式"
                      AutomationProperties.HelpText="クリックまたは左右へドラッグして表示形式を切り替えます"
                      AutomationProperties.ControlTypeOverride="Group">
                <Grid Width="160" Height="38" ColumnDefinitions="80,80">
                  <Border Grid.ColumnSpan="2"
                          Height="36"
                          Margin="1,0"
                          CornerRadius="18"
                          Background="{DynamicResource ModeTrackBrush}"
                          BorderBrush="{DynamicResource ModeTrackBorderBrush}"
                          BorderThickness="0"
                          IsHitTestVisible="False" />
                  <Border x:Name="PdfPreviewSelectionPill"
                          Width="89"
                          Height="39"
                          Margin="-0.5,0,0,0"
                          HorizontalAlignment="Left"
                          CornerRadius="19.5"
                          Background="{DynamicResource ModePillBrush}"
                          BorderBrush="{DynamicResource ModePillBorderBrush}"
                          BorderThickness="1"
                          BoxShadow="0 1 6 0 #0D000000"
                          IsHitTestVisible="False">
                    <Border.RenderTransform>
                      <TranslateTransform X="0">
                        <TranslateTransform.Transitions>
                          <Transitions>
                            <DoubleTransition Property="X"
                                              Duration="0:0:0.5"
                                              Easing="0.18,0.89,0.22,1.04" />
                          </Transitions>
                        </TranslateTransform.Transitions>
                      </TranslateTransform>
                    </Border.RenderTransform>
                  </Border>

                  <RadioButton x:Name="PdfPreviewIconButton"
                               Grid.Column="0"
                               Classes="preview-segment"
                               GroupName="PdfPreviewDisplay"
                               IsChecked="True"
                               AutomationProperties.Name="アイコン表示"
                               Click="OnPdfPreviewIconClick">
                    <TextBlock x:Name="PdfPreviewIconLabel" Text="アイコン">
                      <TextBlock.RenderTransform>
                        <TranslateTransform X="4" />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                  </RadioButton>
                  <RadioButton x:Name="PdfPreviewListButton"
                               Grid.Column="1"
                               Classes="preview-segment"
                               GroupName="PdfPreviewDisplay"
                               AutomationProperties.Name="リスト表示"
                               Click="OnPdfPreviewListClick">
                    <TextBlock x:Name="PdfPreviewListLabel" Text="リスト">
                      <TextBlock.RenderTransform>
                        <TranslateTransform X="-4" />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                  </RadioButton>
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="4"
                    Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    ClipToBounds="True">
              <Grid>
                <ScrollViewer x:Name="PdfPagePreviewThumbnailScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="PdfPagePreviewThumbnailItems">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="150"
                                MinHeight="210"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="8"
                                Padding="8">
                          <StackPanel Spacing="6">
                            <Canvas Width="126" Height="150">
                              <Image Source="{Binding Thumbnail}"
                                     Width="126"
                                     Height="150"
                                     Stretch="Uniform"
                                     PointerPressed="OnPdfPreviewImagePointerPressed" />
                              <Ellipse Width="12"
                                       Height="12"
                                       Fill="#6A6A6A"
                                       Stroke="White"
                                       StrokeThickness="2"
                                       IsVisible="{Binding HasEditMarker}"
                                       Canvas.Left="{Binding EditMarkerLeft}"
                                       Canvas.Top="{Binding EditMarkerTop}" />
                            </Canvas>
                            <TextBlock Text="{Binding PageLabel}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Title}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <CheckBox Content="{Binding SelectionLabel}"
                                      IsVisible="{Binding IsPageSelectionVisible}"
                                      IsChecked="{Binding IsPageSelected}"
                                      Checked="OnPdfPreviewPageSelectionChanged"
                                      Unchecked="OnPdfPreviewPageSelectionChanged" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="PdfPagePreviewListScroll"
                              IsVisible="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="PdfPagePreviewListItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Margin="12,9"
                              PointerPressed="OnPdfPreviewListItemPointerPressed">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding PageLabel}"
                                     Width="72"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PdfPath}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <CheckBox Grid.Column="2"
                                    Content="{Binding SelectionLabel}"
                                    IsVisible="{Binding IsPageSelectionVisible}"
                                    IsChecked="{Binding IsPageSelected}"
                                    VerticalAlignment="Center"
                                    Checked="OnPdfPreviewPageSelectionChanged"
                                    Unchecked="OnPdfPreviewPageSelectionChanged" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="16"
                ClipToBounds="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <TextBlock Text="PDF編集"
                         FontSize="22"
                         FontWeight="Bold"
                         HorizontalAlignment="Center" />

              <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="操作" HorizontalAlignment="Center" />
                  <ComboBox x:Name="PdfToolOperationCombo"
                            SelectedIndex="0"
                            SelectionChanged="OnPdfToolOperationChanged">
                    <ComboBoxItem Content="複数PDFを結合" />
                    <ComboBoxItem Content="1ページずつ分割" />
                    <ComboBoxItem Content="選択ページを削除" />
                    <ComboBoxItem Content="選択ページのみ出力" />
                    <ComboBoxItem Content="文字・テキストを追加" />
                  </ComboBox>
                </StackPanel>
              </Border>

              <StackPanel x:Name="PdfToolOutputPdfPanel">
                <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="PdfToolOutputPdfLabel"
                               Classes="label"
                               Text="出力PDF"
                               HorizontalAlignment="Center" />
                    <TextBox x:Name="PdfToolOutputPdfTextBox" Watermark="保存先とPDF名" />
                    <Button Classes="small-action" Content="選択" Click="OnSelectPdfToolOutputPdfClick" />
                    <TextBlock Classes="label" Text="書き出しファイル名" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="PdfToolOutputPdfBaseNameTextBox" Watermark="例: output" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="PdfToolOutputFolderPanel" IsVisible="False">
                <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="出力先フォルダ" HorizontalAlignment="Center" />
                    <TextBox x:Name="PdfToolOutputFolderTextBox" Watermark="保存先フォルダ" />
                    <Button Classes="small-action" Content="選択" Click="OnSelectPdfToolOutputFolderClick" />
                    <TextBlock Classes="label" Text="書き出しファイル名" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="PdfToolOutputBaseNameTextBox" Watermark="例: split" />
                    <TextBlock Text="分割PDFは _page001 を付けて保存します。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="PdfPageSelectionPanel" IsVisible="False">
                <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="PdfPageSelectionLabel" Classes="label" Text="対象ページ" HorizontalAlignment="Center" />
                    <TextBox x:Name="PdfPageSelectionTextBox" Watermark="例: 1,3,5-7" />
                    <TextBlock x:Name="PdfPageSelectionHelpText"
                               Text="ページ番号はPDFの先頭を1ページ目として指定します。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="PdfSimpleEditPanel" IsVisible="False">
                <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="文字・テキストを追加" HorizontalAlignment="Center" />
                    <TextBlock Text="ページ上をクリックすると拡大編集できます。完了後、開始でまとめて書き出します。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock Text="テキストボックスの追加・移動・サイズ変更は拡大プレビュー上で行います。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,240" Margin="34,0,34,24" ColumnSpacing="22">
      <StackPanel Spacing="10" VerticalAlignment="Center">
        <ProgressBar x:Name="MainProgressBar"
                     Minimum="0"
                     Maximum="100"
                     Height="22"
                     CornerRadius="12" />
        <TextBlock x:Name="StatusText"
                   Text=""
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="15"
                   IsVisible="False" />
      </StackPanel>

      <Grid Grid.Column="1">
        <Button x:Name="StartPdfButton"
                Classes="primary"
                Content="開始"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsVisible="False"
                Click="OnStartPdfConversionClick" />
        <Button x:Name="StartImageButton"
                Classes="primary"
                Content="開始"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsVisible="False"
                Click="OnStartImageConversionClick" />
        <Button x:Name="StartPdfToolButton"
                Classes="primary"
                Content="開始"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Click="OnStartPdfToolClick" />
      </Grid>
    </Grid>

    </Grid>
  </Grid>
</Window>
