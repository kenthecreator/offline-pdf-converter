<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OfflinePDFConverter</AssemblyName>
    <RootNamespace>OfflinePDFConverter</RootNamespace>
    <Product>Offline PDF Converter (v4.3)</Product>
    <Version>4.3.0</Version>
    <AssemblyVersion>4.3.0.0</AssemblyVersion>
    <FileVersion>4.3.0.0</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PaddleOcrEdition)' == 'true'">
    <AssemblyName>OfflinePDFConverter.PaddleEdition</AssemblyName>
    <Product>Offline PDF Converter (v4.3)</Product>
    <DefineConstants>$(DefineConstants);PADDLE_OCR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ocr/windows-x64.zip" LogicalName="OfflinePDFConverter.WindowsOcr.zip" Condition="'$(PaddleOcrEdition)' != 'true'" />
    <EmbeddedResource Include="ocr/windows-x64.sha256" LogicalName="OfflinePDFConverter.WindowsOcr.sha256" Condition="'$(PaddleOcrEdition)' != 'true'" />
    <EmbeddedResource Include="Assets/OcrSelfTest.png" LogicalName="OfflinePDFConverter.OcrSelfTest.png" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <EmbeddedResource Include="Assets/Fonts/*" LogicalName="OfflinePDFConverter.Fonts.%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets\AppIcon.png" />
    <AvaloniaResource Include="Assets\AppIconLight.png" />
    <AvaloniaResource Include="Assets\AppIconDark.png" />
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup Condition="'$(PaddleOcrEdition)' == 'true'">
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build" />
    <EmbeddedResource Include="ocr/paddle/*" LogicalName="OfflinePDFConverter.Paddle.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequirePaddleModels" BeforeTargets="PrepareForBuild" Condition="'$(PaddleOcrEdition)' == 'true'">
    <Error Condition="!Exists('Assets/Fonts/NotoSansJP-Regular.ttf')" Text="Run python scripts/prepare-ocr-font.py before building; see docs/BUILD_WINDOWS.md." />
    <Error Condition="!Exists('ocr/paddle/manifest.json')" Text="Run python3 scripts/prepare-paddle-ocr.py before building PaddleOCR Edition." />
  </Target>
  <Import Project="Properties/WindowsAppLocalCrt.targets" />
</Project>
