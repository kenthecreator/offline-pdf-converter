<Project>
  <!-- v4.2 uses the bundled PaddleOCR engine by default; false keeps legacy regression builds available. -->
  <PropertyGroup>
    <PaddleOcrEdition Condition="'$(PaddleOcrEdition)' == '' and '$(MSBuildProjectName)' == 'OfflinePDFConverter'">true</PaddleOcrEdition>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PaddleOcrEdition)' == 'true'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/paddle-edition/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/paddle-edition/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
